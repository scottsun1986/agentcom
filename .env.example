# Database
DATABASE_URL=postgresql+asyncpg://meetmanager:meetmanager@localhost:5434/agentcom
DATABASE_URL_SYNC=postgresql://meetmanager:meetmanager@localhost:5434/agentcom

# Redis
REDIS_URL=redis://localhost:6379/2

# Server
HOST=0.0.0.0
PORT=8009
DEBUG=true
LOG_LEVEL=info
SQL_ECHO=false

# Default Super Administrator (RuoYi sys_user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@agentcom.local
ADMIN_DISPLAY_NAME=系统超级管理员

# Security & JWT
SECRET_KEY=agentcom-super-secret-key-production-ready-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MCP
MCP_ENDPOINT=/mcp
MCP_SERVER_NAME=agentcom
MCP_SERVER_VERSION=1.0.0

# External integrations
GBRAINKG_URL=http://localhost:3000
